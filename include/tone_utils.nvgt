/* tone_utils.nvgt - tone_synth helpers for Melody Memory.
 * Note playback and a synthesized chord used by the speaker test.
 * All synthesis is procedural - no audio files required.
 */

// Play one musical note immediately (blocking speech-safe, non-blocking playback).
// note_name uses BGT-style notation: "c", "c#", "d4" (octave in the name), etc.
// length is in beats; 1.0 at tempo 120 = 500 ms.
void play_note_immediate(const string&in note_name, double beats = 0.45, int waveform = 1, double volume_db = -6) {
	tone_synth synth;
	synth.set_tempo(120);
	synth.set_volume(volume_db);
	synth.set_waveform_type(waveform);
	synth.set_edge_fades(8, 120);
	synth.note(note_name, beats);
	sound@ s = synth.write_wave_sound();
	if (@s != null) s.play();
}

// A short rising arpeggio chord (c-e-g-c) used as the speaker-test sound.
// Writes a WAV file next to the game executable so the user can also inspect it.
bool generate_test_chord_wav(const string&in filename) {
	tone_synth synth;
	synth.set_tempo(150);
	synth.set_volume(-8);
	synth.set_waveform_type(1); // BGT type 1, modern tone engine wave 3
	synth.set_edge_fades(15, 250);
	synth.note("c4", 0.5);
	synth.note("e4", 0.5);
	synth.note("g4", 0.5);
	synth.note("c5", 0.9);
	return synth.write_wave_file(filename);
}

// Human-readable note names used by speech feedback during gameplay.
string note_display_name(int scale_index) {
	string[] names = {"do", "re", "mi", "fa", "sol", "la", "ti", "do high"};
	if (scale_index >= 0 and scale_index < int(names.length())) return names[scale_index];
	return "note " + (scale_index + 1);
}
